{
  "name": "kdinya/nova-express-woocommerce",
  "description": "Nova Express Woo integration for WooCommerce",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5 || ^10.0"
  },
  "autoload": {
    "psr-4": {
      "NovaExpress\\": "includes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "NovaExpress\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit --configuration phpunit.xml.dist",
    "verify": "bash bin/verify.sh"
  }
}